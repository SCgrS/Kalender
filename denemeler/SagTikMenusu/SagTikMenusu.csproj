<!-- Takvimin üzerindeki sağ tık menüsünün sınaması (satırlar, "10 Ekim'i takvimde aç" metni, ay adlarının ekleri, kaldırılan yeni etkinlik ve yeni görev satırları). Önce src/Kalender.App Release derlenir, sonra: dotnet run -c Release -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UygDll Condition="'$(UygDll)' == ''">$(MSBuildThisFileDirectory)..\..\src\Kalender.App\bin\Release\net10.0-windows\Kalender.dll</UygDll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Uygulama">
      <HintPath>$(UygDll)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
