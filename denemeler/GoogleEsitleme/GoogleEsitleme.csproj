<!-- 1.10 düzeltmesinin sınaması (Google'ın reddettiği erişim anahtarı, eski ay kopyasının yeni verinin üstüne yazılması, uzun süren başarısızlığın günlüğe yazılması). Önce src/Kalender.App Release derlenir, sonra: dotnet run -c Release -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UygDll Condition="'$(UygDll)' == ''">$(MSBuildThisFileDirectory)..\..\src\Kalender.App\bin\Release\net8.0-windows\Kalender.dll</UygDll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Uygulama">
      <HintPath>$(UygDll)</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>
</Project>
