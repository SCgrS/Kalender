<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <AssemblyName>Kalender</AssemblyName>
    <RootNamespace>Kalender</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Kalender.ico</ApplicationIcon>

    <!-- Kaynak dosyalar UTF-8; Turkce karakterler dogru okunsun diye acikca belirtiliyor. -->
    <CodePage>65001</CodePage>

    <Version>1.9</Version>
    <AssemblyVersion>1.9.0.0</AssemblyVersion>
    <FileVersion>1.9.0.0</FileVersion>
    <Product>Kalender</Product>
    <Company>Kalender</Company>
    <Description>Masaustu duvar kagidina islenmis aylik takvim</Description>
    <NeutralLanguage>tr-TR</NeutralLanguage>

    <!-- Tek dosya, kendi kendine yeten yayin. RuntimeIdentifier ve SelfContained
         yayin.ps1 tarafindan komut satirindan verilir; boylece gunluk derleme hizli kalir. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Sikistirma bilerek kapali. Sikistirilmis tek dosyada .NET ve WPF
         kutuphaneleri acilista bellege acilip orada kaliyordu; Kalender bu yuzden
         ~100 MB fazla RAM tutuyordu. Sikistirmasiz dosyada kutuphaneler exe'den
         dogrudan okunuyor. Bedeli: exe 63 MB yerine ~139 MB. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tepsi simgesi tek dosya yayinda da bulunabilsin diye gomuluyor. -->
    <EmbeddedResource Include="Assets\Kalender.ico" LogicalName="Kalender.Assets.Kalender.ico" />
    <!-- Hazir zemin fotograflari (Unsplash lisansli; UCUNCU-TARAF.md) ve ayarlar
         penceresindeki kucuk resimleri. Secilince AppData'ya cikarilir. -->
    <EmbeddedResource Include="Assets\DuvarKagitlari\*.jpg"
                      LogicalName="Kalender.Assets.DuvarKagitlari.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>


