<?xml version="1.0" encoding="utf-8"?>
<!--
  Ayarlar penceresinin denetim biçimleri.

  Windows'un kendi WPF biçimleri karanlık kip tanımıyor: düğmenin üzerine
  gelince açık mavi, metin kutusu beyaz kalıyor. Bu yüzden kullandığımız
  denetimlerin şablonlarını burada sade biçimde yeniden yazıyoruz. Renkler
  DynamicResource ile alınıyor; aydınlık/karanlık geçişinde yalnızca fırça
  değerleri değişiyor, şablonlar aynı kalıyor.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ metin -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource YaziFirca}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource YaziFirca}" />
    </Style>

    <!-- ============================================================= düğme -->

    <Style TargetType="Button">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Foreground" Value="{DynamicResource YaziFirca}" />
        <Setter Property="Background" Value="{DynamicResource DenetimFirca}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KenarFirca}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Govde"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Govde" Property="Background"
                                    Value="{DynamicResource DenetimUstuFirca}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Govde" Property="Background"
                                    Value="{DynamicResource DenetimBasiliFirca}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================= metin kutusu -->

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource YaziFirca}" />
        <Setter Property="Background" Value="{DynamicResource GirdiFirca}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KenarFirca}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource YaziFirca}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource VurguFirca}" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================= işaret kutusu -->

    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource YaziFirca}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Kutu" Width="16" Height="16" CornerRadius="3"
                                VerticalAlignment="Center" Margin="0,1,8,0"
                                Background="{DynamicResource GirdiFirca}"
                                BorderBrush="{DynamicResource KenarGucluFirca}" BorderThickness="1">
                            <Path x:Name="Tik" Stretch="Uniform" Margin="3" Visibility="Collapsed"
                                  Data="M 0,5 L 3.5,9 L 10,0" Stroke="White" StrokeThickness="2"
                                  StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Kutu" Property="Background" Value="{DynamicResource VurguFirca}" />
                            <Setter TargetName="Kutu" Property="BorderBrush" Value="{DynamicResource VurguFirca}" />
                            <Setter TargetName="Tik" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Kutu" Property="BorderBrush" Value="{DynamicResource VurguFirca}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ seçenek -->

    <Style TargetType="RadioButton">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource YaziFirca}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,1,8,0">
                            <Ellipse x:Name="Halka" Fill="{DynamicResource GirdiFirca}"
                                     Stroke="{DynamicResource KenarGucluFirca}" StrokeThickness="1" />
                            <Ellipse x:Name="Nokta" Width="7" Height="7" Visibility="Collapsed"
                                     Fill="{DynamicResource VurguFirca}" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Nokta" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Halka" Property="Stroke" Value="{DynamicResource VurguFirca}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Halka" Property="Stroke" Value="{DynamicResource VurguFirca}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================= açılır liste -->

    <Style x:Key="ComboOkStil" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Govde" Background="{DynamicResource GirdiFirca}"
                            BorderBrush="{DynamicResource KenarFirca}" BorderThickness="1"
                            CornerRadius="5">
                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                              Data="M 0,0 L 8,0 L 4,5 Z" Fill="{DynamicResource SolukYaziFirca}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Govde" Property="BorderBrush" Value="{DynamicResource VurguFirca}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource YaziFirca}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Govde" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Govde" Property="Background" Value="{DynamicResource VurguFirca}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource YaziFirca}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboOkStil}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="10,0,26,0" VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource YuzeyFirca}"
                                    BorderBrush="{DynamicResource KenarGucluFirca}" BorderThickness="1"
                                    CornerRadius="5" MinWidth="{TemplateBinding ActualWidth}"
                                    Margin="0,2,0,0">
                                <ScrollViewer MaxHeight="240">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================= açılır -->

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource YaziFirca}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="Basli" Focusable="False" MinWidth="0"
                                      HorizontalAlignment="Left"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <Path x:Name="Ok" Width="9" Height="9" Stretch="Uniform"
                                              VerticalAlignment="Center" Margin="0,0,8,0"
                                              Data="M 0,0 L 6,4 L 0,8 Z"
                                              Fill="{DynamicResource SolukYaziFirca}" />
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Ok" Property="Data" Value="M 0,0 L 8,0 L 4,6 Z" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter Content="{TemplateBinding Header}" />
                        </ToggleButton>
                        <ContentPresenter x:Name="Icerik" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Icerik" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================= ayraç -->

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource KenarFirca}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== kaydırma çubuğu -->

    <Style x:Key="KaydirmaTutamak" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource KaydiriciFirca}" CornerRadius="4" Margin="3,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource KaydirmaTutamak}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" MinWidth="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" MinWidth="0" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
