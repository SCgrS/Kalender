<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Kalender.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Kalender.Ui"
        Title="Kalender - Ayarlar"
        Width="760" Height="820"
        MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource ZeminFirca}"
        Foreground="{DynamicResource YaziFirca}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Denetimler.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Baslik" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
            <Style x:Key="Aciklama" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{DynamicResource SolukYaziFirca}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
            <Style x:Key="AltBaslik" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="Bolum" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource YuzeyFirca}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource KenarFirca}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource AltBarFirca}" Padding="20,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{DynamicResource SolukYaziFirca}"
                           Text="Değişiklikler anında masaüstüne uygulanır." />
                <Button DockPanel.Dock="Right" Content="Kapat" HorizontalAlignment="Right"
                        Click="OnClose" IsCancel="True" />
                <Button x:Name="ThemeButton" DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Margin="0,0,10,0" MinWidth="130" Click="OnToggleTheme" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18">
            <StackPanel>

                <!-- ================================================ ZEMİN -->
                <Border Style="{StaticResource Bolum}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Baslik}" Text="Zemin" />
                        <TextBlock Style="{StaticResource Aciklama}"
                                   Text="Takvimin üzerine çizildiği arka plan. Seçtiğiniz zemin aynı zamanda Windows duvar kağıdına da yazılır; böylece Kalender açılana kadar ekran farklı görünmez." />

                        <TextBlock Style="{StaticResource AltBaslik}" Text="Hazır renkler" Margin="0,4,0,8" />
                        <WrapPanel x:Name="PresetPanel" />

                        <TextBlock Style="{StaticResource AltBaslik}" Text="Kendi rengim" Margin="0,18,0,10" />
                        <ui:ColorWheel x:Name="BackgroundWheel" HorizontalAlignment="Left" />

                        <Separator Margin="0,16,0,12" />

                        <TextBlock Style="{StaticResource AltBaslik}" Text="Fotoğraf" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Fotoğraf seç…" Click="OnPickPhoto" />
                            <Button x:Name="RemovePhotoButton" Content="Fotoğrafı kaldır"
                                    Margin="10,0,0,0" Click="OnRemovePhoto" MinWidth="120" />
                            <TextBlock Text="Yerleşim" VerticalAlignment="Center" Margin="20,0,8,0" />
                            <ComboBox x:Name="FitCombo" Width="120" VerticalAlignment="Center"
                                      SelectionChanged="OnFitChanged" />
                        </StackPanel>
                        <TextBlock x:Name="PhotoPathText" Style="{StaticResource Aciklama}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- ================================================= YAZI -->
                <Border Style="{StaticResource Bolum}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Baslik}" Text="Yazı" />

                        <CheckBox x:Name="AutoTextColorBox" Content="Yazı rengini zemine göre otomatik seç"
                                  Checked="OnAutoTextColorChanged" Unchecked="OnAutoTextColorChanged" />
                        <TextBlock x:Name="AutoTextNote" Style="{StaticResource Aciklama}" Margin="24,4,0,0"
                                   Text="Düz renk zeminde açık/koyu yazı otomatik seçilir. Fotoğraf zeminde otomatik seçim yapılamaz; rengi siz belirlersiniz." />

                        <Expander Header="Yazı rengini seç" x:Name="TextColorExpander" Margin="0,8,0,0">
                            <ui:ColorWheel x:Name="TextWheel" Margin="0,14,0,4" />
                        </Expander>

                        <CheckBox x:Name="SaturdayRedBox" Content="Cumartesi de pazar gibi kırmızı olsun"
                                  Margin="0,14,0,0"
                                  Checked="OnSaturdayChanged" Unchecked="OnSaturdayChanged" />

                        <StackPanel x:Name="DimPanel" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource AltBaslik}"
                                       Text="Takvimin arkasını karart (fotoğraf zeminde)" />
                            <TextBlock Style="{StaticResource Aciklama}" Margin="0,4,0,6"
                                       Text="Fotoğrafın üzerinde yazılar okunmuyorsa takvimin arkasına yumuşak bir gölge koyar." />
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="DimSlider" Width="260" Minimum="0" Maximum="100"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" ValueChanged="OnDimChanged" />
                                <TextBlock x:Name="DimText" Width="56" Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ======================================= TAKVİM RENKLERİ -->
                <Border Style="{StaticResource Bolum}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Baslik}" Text="Takvim renkleri" />
                        <TextBlock Style="{StaticResource Aciklama}"
                                   Text="Masaüstündeki takvimin yazı renkleri. Hepsi otomatik başlar: renkler zemine ve yazı rengine göre kendiliğinden hesaplanır. Otomatik işaretini kaldırdığınız başlığın rengini siz seçersiniz. Gün altındaki noktacıklar buraya dahil değil; onların rengi Google Takvim'deki takvim ve etkinlik renginden gelir." />

                        <TextBlock Style="{StaticResource AltBaslik}" Text="Hafta günleri ve ay adı" />
                        <CheckBox x:Name="WeekdayAutoBox" Content="Otomatik"
                                  Checked="OnWeekdayAutoChanged" Unchecked="OnWeekdayAutoChanged" />
                        <Expander x:Name="WeekdayColorExpander" Header="Rengi seç" Margin="0,8,0,0">
                            <ui:ColorWheel x:Name="WeekdayWheel" Margin="0,12,0,4" HorizontalAlignment="Left" />
                        </Expander>

                        <Separator Margin="0,16,0,14" />

                        <TextBlock Style="{StaticResource AltBaslik}" Text="Tatil ve hafta sonu günleri" />
                        <CheckBox x:Name="HolidayAutoBox" Content="Otomatik"
                                  Checked="OnHolidayColorAutoChanged" Unchecked="OnHolidayColorAutoChanged" />
                        <Expander x:Name="HolidayColorExpander" Header="Rengi seç" Margin="0,8,0,0">
                            <ui:ColorWheel x:Name="HolidayWheel" Margin="0,12,0,4" HorizontalAlignment="Left" />
                        </Expander>

                        <Separator Margin="0,16,0,14" />

                        <TextBlock Style="{StaticResource AltBaslik}"
                                   Text="Pasif günler (önceki ve sonraki aydan taşanlar)" />
                        <CheckBox x:Name="MutedAutoBox" Content="Otomatik"
                                  Checked="OnMutedColorAutoChanged" Unchecked="OnMutedColorAutoChanged" />
                        <Expander x:Name="MutedColorExpander" Header="Rengi seç" Margin="0,8,0,0">
                            <ui:ColorWheel x:Name="MutedWheel" Margin="0,12,0,4" HorizontalAlignment="Left" />
                        </Expander>

                        <Separator Margin="0,16,0,14" />

                        <TextBlock Style="{StaticResource AltBaslik}" Text="Bugünün arkasındaki daire" />
                        <CheckBox x:Name="TodayCircleAutoBox" Content="Otomatik"
                                  Checked="OnTodayCircleAutoChanged" Unchecked="OnTodayCircleAutoChanged" />
                        <Expander x:Name="TodayCircleExpander" Header="Rengi seç" Margin="0,8,0,0">
                            <ui:ColorWheel x:Name="TodayCircleWheel" Margin="0,12,0,4" HorizontalAlignment="Left" />
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- ============================================== TATİLLER -->
                <Border Style="{StaticResource Bolum}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Baslik}" Text="Resmi tatiller" />

                        <CheckBox x:Name="HolidaysBox" Content="Resmi tatilleri kırmızı göster"
                                  Margin="0,0,0,0"
                                  Checked="OnHolidaysEnabledChanged" Unchecked="OnHolidaysEnabledChanged" />
                        <TextBlock Style="{StaticResource Aciklama}" Margin="24,4,0,0"
                                   Text="Liste, Google'ın Türkiye resmi tatil takviminden alınır ve bilgisayarınızda saklanır; ayda bir yenilenir. İnternet olmadığında en son indirilen liste kullanılır. Arifeler (yarım günler) kırmızı gösterilmez." />

                        <Border Background="{DynamicResource UyariZeminFirca}"
                                BorderBrush="{DynamicResource UyariKenarFirca}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,4,0,0">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Dini bayram tarihleri idari kararla değişebilir; lütfen resmi kaynaklardan teyit ediniz." />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ================================================ GOOGLE -->
                <Border Style="{StaticResource Bolum}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Baslik}" Text="Google Takvim ve Görevler" />
                        <TextBlock Style="{StaticResource Aciklama}"
                                   Text="Kalender hesabınıza yalnızca okuma izniyle bağlanır; etkinlik ya da görev eklemez, silmez. Bağlantı doğrudan sizinle Google arasındadır, arada başka bir sunucu yoktur." />

                        <Expander Header="Client ID nasıl alınır? (bir kerelik)" Margin="0,0,0,12">
                            <StackPanel Margin="4,10,0,4">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"><Run
                                    Text="1. " /><Hyperlink NavigateUri="https://console.cloud.google.com"
                                    RequestNavigate="OnLinkClicked">console.cloud.google.com</Hyperlink><Run
                                    Text=" adresine kendi Google hesabınızla girin." /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="2. Üstteki proje seçiciden yeni bir proje oluşturun (adı önemli değil, örn. Kalender)." />
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="3. Sol menüden API'ler ve Hizmetler &gt; Kitaplık'a girin; Google Calendar API ve Google Tasks API'yi bulup ikisini de Etkinleştir'e basın." />
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="4. API'ler ve Hizmetler &gt; OAuth izin ekranı'na girin (Google Auth Platform sayfasına yönlendirir). Get started &gt; uygulama adı ve e-postanız &gt; Audience: External &gt; iletişim e-postanız &gt; ilkeyi kabul edip Create." />
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="5. Sol menüden Audience &gt; Test users &gt; + Add users: kendi e-posta adresinizi ekleyin. Bu şart; eklemezseniz Google onay ekranında sizi reddeder." />
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="6. Sol menüden Clients &gt; + Create client. Application type: Desktop app. Ad: Kalender &gt; Create." />
                                <TextBlock TextWrapping="Wrap"
                                           Text="7. Çıkan pencerede Client ID ve Client secret yazar. İkisini de aşağıya yapıştırın." />
                            </StackPanel>
                        </Expander>

                        <TextBlock Style="{StaticResource AltBaslik}" Text="İstemci kimliği (Client ID)"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="ClientIdBox" FontFamily="Consolas" FontSize="12"
                                 LostFocus="OnGoogleCredentialsChanged" />

                        <TextBlock Style="{StaticResource AltBaslik}" Text="İstemci gizli anahtarı (Client secret)"
                                   Margin="0,12,0,4" />
                        <TextBox x:Name="ClientSecretBox" FontFamily="Consolas" FontSize="12"
                                 LostFocus="OnGoogleCredentialsChanged" />
                        <TextBlock Style="{StaticResource Aciklama}" Margin="0,4,0,0"
                                   Text="Bu iki değer uygulamanın içinde gömülü değildir; sizin projenize aittir ve bilgisayarınızda şifreli saklanır." />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="ConnectButton" Content="Google'a bağlan" MinWidth="150"
                                    Click="OnConnectGoogle" />
                            <Button x:Name="DisconnectButton" Content="Bağlantıyı kes" Margin="10,0,0,0"
                                    MinWidth="130" Click="OnDisconnectGoogle" />
                        </StackPanel>

                        <TextBlock x:Name="GoogleStatusText" Margin="0,12,0,0" TextWrapping="Wrap" />

                        <StackPanel x:Name="GoogleDetailsPanel" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Ne sıklıkla yenilensin?" VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <ComboBox x:Name="PollIntervalCombo" Width="140" VerticalAlignment="Center"
                                          SelectionChanged="OnPollIntervalChanged" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource AltBaslik}" Text="Gösterilecek takvimler"
                                       Margin="0,0,0,6" />
                            <StackPanel x:Name="CalendarListPanel" Margin="4,0,0,10" />

                            <TextBlock Style="{StaticResource AltBaslik}" Text="Gösterilecek görev listeleri"
                                       Margin="0,6,0,6" />
                            <StackPanel x:Name="TaskListPanel" Margin="4,0,0,10" />

                            <TextBlock Style="{StaticResource Aciklama}" Margin="0,4,0,0"
                                       Text="Google, görev listeleri için renk vermiyor; bütün görevler tek renkle gösterilir." />
                            <Expander Header="Görev noktacığı rengi" Margin="0,4,0,0">
                                <ui:ColorWheel x:Name="TaskColorWheel" Margin="0,12,0,4"
                                               HorizontalAlignment="Left" />
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================================== EKRANLAR -->
                <Border Style="{StaticResource Bolum}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Baslik}" Text="Ekranlar" />

                        <TextBlock Style="{StaticResource AltBaslik}"
                                   Text="Takvim hangi ekranlarda görünsün?" />
                        <RadioButton x:Name="AllScreensRadio" GroupName="Hedef" Content="Tüm ekranlarda"
                                     Checked="OnDisplayTargetChanged" />
                        <RadioButton x:Name="PrimaryOnlyRadio" GroupName="Hedef" Content="Yalnız ana ekranda"
                                     Checked="OnDisplayTargetChanged" />
                        <RadioButton x:Name="SelectedScreensRadio" GroupName="Hedef" Content="Seçtiğim ekranlarda"
                                     Checked="OnDisplayTargetChanged" />

                        <Separator Margin="0,16,0,12" />

                        <ItemsControl x:Name="MonitorList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" BorderBrush="{DynamicResource KenarFirca}"
                                            CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="12"
                                                               Foreground="{DynamicResource SolukYaziFirca}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button DockPanel.Dock="Right" Content="Takvimi taşı"
                                                        HorizontalAlignment="Right" MinWidth="110"
                                                        Click="OnMoveCalendar" Tag="{Binding}" />
                                            </DockPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <TextBlock Text="Boyut" VerticalAlignment="Center"
                                                           Width="46" />
                                                <Slider Width="240" Minimum="80" Maximum="150"
                                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                                        VerticalAlignment="Center"
                                                        Value="{Binding ScalePercent, Mode=TwoWay}" />
                                                <TextBlock Text="{Binding ScaleText}" Width="52"
                                                           Margin="12,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <CheckBox Content="Bu ekranda göster" VerticalAlignment="Center"
                                                          Margin="0" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                                <Button Content="Bu ekrana fotoğraf…" Margin="24,0,0,0"
                                                        MinWidth="150" Click="OnPickMonitorPhoto"
                                                        Tag="{Binding}" />
                                                <Button Content="Kaldır" Margin="8,0,0,0" MinWidth="80"
                                                        Click="OnRemoveMonitorPhoto" Tag="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ================================================= GENEL -->
                <Border Style="{StaticResource Bolum}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Baslik}" Text="Genel" />

                        <CheckBox x:Name="StartupBox" Content="Windows açılışında Kalender'i başlat"
                                  Checked="OnStartupChanged" Unchecked="OnStartupChanged" />
                        <TextBlock x:Name="StartupNote" Style="{StaticResource Aciklama}" Margin="24,4,0,0" />

                        <CheckBox x:Name="WallpaperSyncBox"
                                  Content="Seçilen zemini Windows duvar kağıdı olarak da ayarla"
                                  Checked="OnWallpaperSyncChanged" Unchecked="OnWallpaperSyncChanged" />
                        <TextBlock Style="{StaticResource Aciklama}" Margin="24,4,0,0"
                                   Text="Açılışta Kalender devreye girene kadar ekranın farklı görünmemesi için. Kapatırsanız Windows duvar kağıdınıza dokunulmaz." />

                        <Separator Margin="0,14,0,12" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Günlük ayrıntısı" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox x:Name="LogLevelCombo" Width="150" VerticalAlignment="Center"
                                      SelectionChanged="OnLogLevelChanged" />
                            <Button Content="Günlük klasörünü aç" Margin="14,0,0,0" MinWidth="160"
                                    Click="OnOpenLogFolder" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Aciklama}"
                                   Text="Normalde yalnızca hatalar yazılır. Bir sorunu araştırırken ayrıntıyı artırabilirsiniz; günlükler küçük tutulur ve eskiyenler silinir." />

                        <Separator Margin="0,14,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="VersionText" VerticalAlignment="Center" />
                            <Button Content="Sürümler sayfası" Margin="16,0,0,0" MinWidth="140"
                                    Click="OnOpenReleases" />
                            <Button x:Name="UninstallButton" Content="Kalender'i kaldır"
                                    Margin="10,0,0,0" MinWidth="140" Click="OnUninstall" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Aciklama}" Margin="0,8,0,0"
                                   Text="Kalender kendini otomatik güncellemez. Yeni sürüm çıktığında sürümler sayfasından indirebilirsiniz." />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
