<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Kalender.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Kalender.Ui"
        Title="Kalender - Ayarlar"
        Width="900" Height="680"
        MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource ZeminFirca}"
        Foreground="{DynamicResource YaziFirca}"
        FontFamily="Segoe UI" FontSize="14">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Denetimler.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              Yazı düzeni Windows 11 Ayarlar'daki gibi: sayfa başlığı 28, grup
              başlığı 14 kalın, ayar adı 14, açıklama 12 soluk. Boşluklar 4'ün katları.
            -->
            <Style x:Key="SayfaBasligi" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="GrupBasligi" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="2,28,0,8" />
            </Style>
            <Style x:Key="IlkGrupBasligi" TargetType="TextBlock" BasedOn="{StaticResource GrupBasligi}">
                <Setter Property="Margin" Value="2,0,0,8" />
            </Style>
            <Style x:Key="GrupAciklamasi" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource SolukYaziFirca}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="2,-4,0,12" />
            </Style>
            <Style x:Key="SatirBasligi" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SatirAciklamasi" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource SolukYaziFirca}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Ayar kartı; içindeki satırlar ince çizgilerle ayrılır. -->
            <Style x:Key="Kart" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource YuzeyFirca}" />
                <Setter Property="BorderBrush" Value="{DynamicResource KenarFirca}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <!-- Kart satırı: solda ad ve açıklama, sağa yaslı denetim (DockPanel.Dock="Right"). -->
            <Style x:Key="Satir" TargetType="DockPanel">
                <Setter Property="Margin" Value="16,12" />
                <Setter Property="MinHeight" Value="40" />
            </Style>

            <!-- Adın altında tam genişlikte denetim duran satır (ör. uzun metin kutusu). -->
            <Style x:Key="DikeySatir" TargetType="StackPanel">
                <Setter Property="Margin" Value="16,14,16,16" />
            </Style>

            <Style x:Key="UyariKutusu" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource UyariZeminFirca}" />
                <Setter Property="BorderBrush" Value="{DynamicResource UyariKenarFirca}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="12,10" />
            </Style>

            <!-- Google kurulum adımları: numara solda, metin sağda kırılır. -->
            <Style x:Key="Adim" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="AdimNo" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Width" Value="22" />
                <Setter Property="Foreground" Value="{DynamicResource SolukYaziFirca}" />
                <Setter Property="DockPanel.Dock" Value="Left" />
            </Style>

            <Style x:Key="Sayfa" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Padding" Value="36,0,22,28" />
                <Setter Property="Visibility" Value="Collapsed" />
            </Style>
            <Style x:Key="SayfaIcerigi" TargetType="StackPanel">
                <Setter Property="MaxWidth" Value="900" />
            </Style>

            <!-- ==================================================== simgeler -->
            <!-- 16 piksellik ızgaraya çizgiyle çizilir; yazı tipi karakteri kullanılmaz. -->

            <Style x:Key="Simge" TargetType="Path">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Stroke" Value="{DynamicResource YaziFirca}" />
                <Setter Property="StrokeThickness" Value="1.25" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
            </Style>

            <GeometryGroup x:Key="SimgeArkaPlan">
                <RectangleGeometry Rect="1.5,2.5,13,11" RadiusX="2" RadiusY="2" />
                <PathGeometry Figures="M 2,12.5 L 6,8.5 L 9.5,12 M 8.5,11 L 10.5,9 L 14,12.5" />
                <EllipseGeometry Center="10.75,5.75" RadiusX="1.25" RadiusY="1.25" />
            </GeometryGroup>

            <GeometryGroup x:Key="SimgeTakvim">
                <RectangleGeometry Rect="1.5,2.5,13,12" RadiusX="2" RadiusY="2" />
                <PathGeometry Figures="M 1.5,6.5 L 14.5,6.5 M 5,1 L 5,4 M 11,1 L 11,4 M 4.5,9.5 L 5.5,9.5 M 7.5,9.5 L 8.5,9.5 M 10.5,9.5 L 11.5,9.5 M 4.5,12 L 5.5,12 M 7.5,12 L 8.5,12" />
            </GeometryGroup>

            <GeometryGroup x:Key="SimgeEkran">
                <RectangleGeometry Rect="1.5,2.5,13,9" RadiusX="1.5" RadiusY="1.5" />
                <PathGeometry Figures="M 8,11.5 L 8,14 M 5,14 L 11,14" />
            </GeometryGroup>

            <!-- Google sayfası: bulut ve içinde eşitleme okları; marka logosu değil, çevrimiçi hesap anlamında. -->
            <GeometryGroup x:Key="SimgeBulut">
                <PathGeometry Figures="M 4.5,13 A 3,3 0 0 1 4.3,7.02 A 4,4 0 0 1 11.75,6.3 A 3.35,3.35 0 0 1 11.5,13 Z" />
                <PathGeometry Figures="M 6.1,10.6 A 2,2 0 0 1 9.6,9.4 M 9.9,8.3 L 9.6,9.4 L 8.5,9.2" />
            </GeometryGroup>

            <GeometryGroup x:Key="SimgeGenel">
                <PathGeometry Figures="M 6.62,3.19 L 6.92,1.18 A 6.9,6.9 0 0 1 9.08,1.18 L 9.38,3.19 A 5,5 0 0 1 10.42,3.63 L 12.06,2.42 A 6.9,6.9 0 0 1 13.58,3.94 L 12.37,5.58 A 5,5 0 0 1 12.81,6.62 L 14.82,6.92 A 6.9,6.9 0 0 1 14.82,9.08 L 12.81,9.38 A 5,5 0 0 1 12.37,10.42 L 13.58,12.06 A 6.9,6.9 0 0 1 12.06,13.58 L 10.42,12.37 A 5,5 0 0 1 9.38,12.81 L 9.08,14.82 A 6.9,6.9 0 0 1 6.92,14.82 L 6.62,12.81 A 5,5 0 0 1 5.58,12.37 L 3.94,13.58 A 6.9,6.9 0 0 1 2.42,12.06 L 3.63,10.42 A 5,5 0 0 1 3.19,9.38 L 1.18,9.08 A 6.9,6.9 0 0 1 1.18,6.92 L 3.19,6.62 A 5,5 0 0 1 3.63,5.58 L 2.42,3.94 A 6.9,6.9 0 0 1 3.94,2.42 L 5.58,3.63 A 5,5 0 0 1 6.62,3.19 Z" />
                <EllipseGeometry Center="8,8" RadiusX="2.1" RadiusY="2.1" />
            </GeometryGroup>

            <GeometryGroup x:Key="SimgeBilgi">
                <EllipseGeometry Center="8,8" RadiusX="6.5" RadiusY="6.5" />
                <PathGeometry Figures="M 8,7.25 L 8,11.25" />
                <EllipseGeometry Center="8,4.9" RadiusX="0.2" RadiusY="0.2" />
            </GeometryGroup>

            <!-- Uyarı kutusundaki ünlem: dolgulu çizgi ve nokta, sarı dairenin üstünde. -->
            <!-- Güncelleme bildirimindeki indirme oku. -->
            <PathGeometry x:Key="SimgeIndir" Figures="M 8,1.5 L 8,10.25 M 4.5,6.75 L 8,10.25 L 11.5,6.75 M 2.5,13.75 L 13.5,13.75" />
            <PathGeometry x:Key="SimgeUnlem"
                          Figures="M 7.3,4 L 8.7,4 L 8.45,9.3 L 7.55,9.3 Z
                                   M 7.15,11.5 A 0.85,0.85 0 1 1 8.85,11.5 A 0.85,0.85 0 1 1 7.15,11.5 Z" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- ===================================================== kenar çubuğu -->
        <Border Background="{DynamicResource NavZeminFirca}">
            <!-- Satırlar görünüş sırasında; sekme sırası da böylece üstten alta gider. -->
            <Grid Margin="12,20,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="10,0,0,24">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource VurguFirca}">
                        <Path Style="{StaticResource Simge}" Data="{StaticResource SimgeTakvim}"
                              Stroke="{DynamicResource VurguYaziFirca}" StrokeThickness="1.4" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Kalender" FontWeight="SemiBold" />
                        <TextBlock Text="Ayarlar" FontSize="12" Foreground="{DynamicResource SolukYaziFirca}" />
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="NavList" Grid.Row="1" Style="{StaticResource GezintiListesi}"
                         ItemContainerStyle="{StaticResource GezintiOgesi}"
                         AutomationProperties.Name="Ayar sayfaları"
                         SelectionChanged="OnNavigate">
                    <ListBoxItem AutomationProperties.Name="Arka plan">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Simge}" Data="{StaticResource SimgeArkaPlan}" Margin="0,0,14,0" />
                            <TextBlock Text="Arka plan" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Renkler">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Simge}" Data="{StaticResource SimgeTakvim}" Margin="0,0,14,0" />
                            <TextBlock Text="Renkler" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Boyut ve Konum">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Simge}" Data="{StaticResource SimgeEkran}" Margin="0,0,14,0" />
                            <TextBlock Text="Boyut ve Konum" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Google">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Simge}" Data="{StaticResource SimgeBulut}" Margin="0,0,14,0" />
                            <TextBlock Text="Google" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Genel">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Simge}" Data="{StaticResource SimgeGenel}" Margin="0,0,14,0" />
                            <TextBlock Text="Genel" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <StackPanel Grid.Row="2">
                    <!--
                      Yeni sürüm bildirimi: yalnızca güncelleme varken görünür,
                      tıklayınca indirilip kurulur. Yazılar vurgu zemininde
                      okunsun diye renkleri açıkça veriliyor; genel TextBlock
                      biçimi yoksa pencerenin yazı rengini basardı.
                    -->
                    <Button x:Name="UpdateButton" Style="{StaticResource VurguDugmesi}" Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch" Padding="12,8" Margin="0,0,0,16"
                            Click="OnUpdateClick">
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Style="{StaticResource Simge}" Data="{StaticResource SimgeIndir}"
                                  Stroke="{DynamicResource VurguYaziFirca}" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource VurguYaziFirca}" />
                                <TextBlock x:Name="UpdateDetail" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource VurguYaziFirca}" />
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                        <ToggleButton x:Name="ThemeToggle" VerticalAlignment="Center"
                                      Style="{StaticResource GunesAyAnahtari}"
                                      Checked="OnThemeToggled" Unchecked="OnThemeToggled" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================== içerik -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitle" Style="{StaticResource SayfaBasligi}" Margin="38,24,36,20" />

            <Grid Grid.Row="1">

                <!-- ============================================ ARKA PLAN -->
                <ScrollViewer x:Name="BackgroundPage" Style="{StaticResource Sayfa}">
                    <StackPanel Style="{StaticResource SayfaIcerigi}">
                        <TextBlock Style="{StaticResource IlkGrupBasligi}" Text="Zemin rengi" />
                        <Border Style="{StaticResource Kart}">
                            <StackPanel>
                                <StackPanel Margin="16,14,16,14">
                                    <TextBlock Style="{StaticResource SatirBasligi}" Text="Hazır renkler" />
                                    <TextBlock Style="{StaticResource SatirAciklamasi}"
                                               Text="Takvimin üzerine çizildiği arka plan. Seçtiğiniz zemin aynı zamanda Windows duvar kağıdına da yazılır; böylece Kalender açılana kadar ekran farklı görünmez." />
                                    <WrapPanel x:Name="PresetPanel" Margin="-2,12,0,-8"
                                               KeyboardNavigation.TabNavigation="Once"
                                               KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </StackPanel>
                                <Separator />
                                <DockPanel Style="{StaticResource Satir}">
                                    <ui:ColorPickerButton x:Name="BackgroundColorButton" DockPanel.Dock="Right"
                                                          Margin="16,0,0,0" VerticalAlignment="Center"
                                                          Title="Kendi rengim" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}" Text="Kendi rengim" />
                                        <TextBlock x:Name="CustomColorNote" Style="{StaticResource SatirAciklamasi}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource GrupBasligi}" Text="Fotoğraf" />
                        <Border Style="{StaticResource Kart}">
                            <StackPanel>
                                <StackPanel Margin="16,14,16,14">
                                    <TextBlock Style="{StaticResource SatirBasligi}" Text="Hazır fotoğraflar" />
                                    <TextBlock Style="{StaticResource SatirAciklamasi}"
                                               Text="Uygulamayla gelen fotoğraflar; takvimin renkleriyle okunacak koyu tonlarda seçildi. Birine tıklayınca zemin o fotoğraf olur." />
                                    <!-- Küçük resimler koddan kurulur (BuildReadyPhotos). -->
                                    <WrapPanel x:Name="ReadyPhotoPanel" Margin="-2,12,0,-8"
                                               KeyboardNavigation.TabNavigation="Once"
                                               KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </StackPanel>
                                <Separator />
                                <DockPanel Style="{StaticResource Satir}">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                Margin="16,0,0,0" VerticalAlignment="Center">
                                        <Button Content="Fotoğraf seç…" Click="OnPickPhoto" />
                                        <Button x:Name="RemovePhotoButton" Content="Fotoğrafı kaldır"
                                                Margin="8,0,0,0" Click="OnRemovePhoto" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}" Text="Zemin fotoğrafı" />
                                        <TextBlock x:Name="PhotoPathText" Style="{StaticResource SatirAciklamasi}" />
                                    </StackPanel>
                                </DockPanel>
                                <Separator />
                                <DockPanel Style="{StaticResource Satir}">
                                    <ComboBox x:Name="FitCombo" DockPanel.Dock="Right" Width="150"
                                              Margin="16,0,0,0" VerticalAlignment="Center"
                                              AutomationProperties.Name="Yerleşim"
                                              SelectionChanged="OnFitChanged" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}" Text="Yerleşim" />
                                        <TextBlock Style="{StaticResource SatirAciklamasi}"
                                                   Text="Fotoğrafın ekrana nasıl yerleşeceği." />
                                    </StackPanel>
                                </DockPanel>
                                <Separator />
                                <DockPanel x:Name="DimPanel" Style="{StaticResource Satir}">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                Margin="16,0,0,0" VerticalAlignment="Center">
                                        <Slider x:Name="DimSlider" Width="160" Minimum="0" Maximum="100"
                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Takvimin arkasını karart"
                                                ValueChanged="OnDimChanged" />
                                        <TextBlock x:Name="DimText" Width="40" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}"
                                                   Text="Takvimin arkasını karart (fotoğraf zeminde)" />
                                        <TextBlock Style="{StaticResource SatirAciklamasi}"
                                                   Text="Fotoğrafın üzerinde yazılar okunmuyorsa takvimin arkasına bir gölge koyar. Değer arttıkça gölge koyulaşır ve köşeleri düzleşir; %100'de tam opak bir kare olur." />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================================== RENKLER -->
                <ScrollViewer x:Name="CalendarPage" Style="{StaticResource Sayfa}">
                    <StackPanel Style="{StaticResource SayfaIcerigi}">
                        <TextBlock Style="{StaticResource IlkGrupBasligi}" Text="Takvim renkleri" />
                        <TextBlock Style="{StaticResource GrupAciklamasi}"
                                   Text="Hepsi otomatik başlar: renkler zemine ve yazı rengine göre kendiliğinden hesaplanır. Bir renk seçtiğinizde o satır elle seçilmiş olur; Otomatik'i yeniden açınca hesaplanan renge döner. Gün altındaki noktacıklar buraya dahil değil; onların rengi Google Takvim'deki takvim ve etkinlik renginden gelir." />
                        <Border Style="{StaticResource Kart}">
                            <StackPanel>
                                <!-- Renk düğmesi ve anahtar tek panelde, görünüş sırasıyla: sekme soldan sağa gider. -->
                                <DockPanel Style="{StaticResource Satir}">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ui:ColorPickerButton x:Name="TextColorButton"
                                                              Margin="16,0,0,0" VerticalAlignment="Center"
                                                              Title="Yazı rengi" />
                                        <CheckBox x:Name="AutoTextColorBox" Content="Otomatik"
                                                  Margin="24,0,0,0" AutomationProperties.Name="Yazı rengi: otomatik"
                                                  Checked="OnAutoTextColorChanged" Unchecked="OnAutoTextColorChanged" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}" Text="Yazı rengi" />
                                        <TextBlock x:Name="AutoTextNote" Style="{StaticResource SatirAciklamasi}" />
                                    </StackPanel>
                                </DockPanel>
                                <Separator />
                                <DockPanel Style="{StaticResource Satir}">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ui:ColorPickerButton x:Name="WeekdayColorButton"
                                                              Margin="16,0,0,0" VerticalAlignment="Center"
                                                              Title="Hafta günleri ve ay adı" />
                                        <CheckBox x:Name="WeekdayAutoBox" Content="Otomatik"
                                                  Margin="24,0,0,0"
                                                  AutomationProperties.Name="Hafta günleri ve ay adı: otomatik" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}" Text="Hafta günleri ve ay adı" />
                                        <TextBlock Style="{StaticResource SatirAciklamasi}"
                                                   Text="Ay adı, gün adları ve ayın olağan günleri." />
                                    </StackPanel>
                                </DockPanel>
                                <Separator />
                                <DockPanel Style="{StaticResource Satir}">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ui:ColorPickerButton x:Name="HolidayColorButton"
                                                              Margin="16,0,0,0" VerticalAlignment="Center"
                                                              Title="Tatil ve hafta sonu günleri" />
                                        <CheckBox x:Name="HolidayAutoBox" Content="Otomatik"
                                                  Margin="24,0,0,0"
                                                  AutomationProperties.Name="Tatil ve hafta sonu günleri: otomatik" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}" Text="Tatil ve hafta sonu günleri" />
                                        <TextBlock Style="{StaticResource SatirAciklamasi}"
                                                   Text="Pazar ve resmi tatiller; ayar açıksa cumartesi de." />
                                    </StackPanel>
                                </DockPanel>
                                <Separator />
                                <DockPanel Style="{StaticResource Satir}">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ui:ColorPickerButton x:Name="MutedColorButton"
                                                              Margin="16,0,0,0" VerticalAlignment="Center"
                                                              Title="Pasif günler" />
                                        <CheckBox x:Name="MutedAutoBox" Content="Otomatik"
                                                  Margin="24,0,0,0"
                                                  AutomationProperties.Name="Pasif günler: otomatik" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}" Text="Pasif günler" />
                                        <TextBlock Style="{StaticResource SatirAciklamasi}"
                                                   Text="Önceki ve sonraki aydan taşan günler." />
                                    </StackPanel>
                                </DockPanel>
                                <Separator />
                                <DockPanel Style="{StaticResource Satir}">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ui:ColorPickerButton x:Name="TodayCircleColorButton"
                                                              Margin="16,0,0,0" VerticalAlignment="Center"
                                                              Title="Bugünün dairesi" />
                                        <CheckBox x:Name="TodayCircleAutoBox" Content="Otomatik"
                                                  Margin="24,0,0,0"
                                                  AutomationProperties.Name="Bugünün dairesi: otomatik" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}" Text="Bugünün dairesi" />
                                        <TextBlock Style="{StaticResource SatirAciklamasi}"
                                                   Text="Bugünün arkasındaki dolu daire." />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource GrupBasligi}" Text="Tatiller" />
                        <Border Style="{StaticResource Kart}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Satir}">
                                    <CheckBox x:Name="HolidaysBox" DockPanel.Dock="Right" Margin="24,0,0,0"
                                              AutomationProperties.Name="Resmi tatilleri kırmızı göster"
                                              Checked="OnHolidaysEnabledChanged" Unchecked="OnHolidaysEnabledChanged" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}" Text="Resmi tatilleri kırmızı göster" />
                                        <TextBlock Style="{StaticResource SatirAciklamasi}"
                                                   Text="Liste, Google'ın Türkiye resmi tatil takviminden alınır ve bilgisayarınızda saklanır; ayda bir yenilenir. İnternet olmadığında en son indirilen liste kullanılır. Arifeler (yarım günler) kırmızı gösterilmez." />
