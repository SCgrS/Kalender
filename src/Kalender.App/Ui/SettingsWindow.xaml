                                        <TextBlock TextWrapping="Wrap"
                                                   Text="Dini bayram tarihleri idari kararla değişebilir; lütfen resmi kaynaklardan teyit ediniz." />
                                    </DockPanel>
                                </Border>
                                <Separator />
                                <DockPanel Style="{StaticResource Satir}">
                                    <CheckBox x:Name="SaturdayRedBox" DockPanel.Dock="Right" Margin="24,0,0,0"
                                              AutomationProperties.Name="Cumartesi de pazar gibi kırmızı olsun"
                                              Checked="OnSaturdayChanged" Unchecked="OnSaturdayChanged" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}"
                                                   Text="Cumartesi de pazar gibi kırmızı olsun" />
                                        <TextBlock Style="{StaticResource SatirAciklamasi}"
                                                   Text="Cumartesi günleri de tatil rengiyle gösterilir." />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource GrupBasligi}" Text="Gün kutusu" />
                        <Border Style="{StaticResource Kart}">
                            <DockPanel Style="{StaticResource Satir}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            Margin="16,0,0,0" VerticalAlignment="Center">
                                    <Slider x:Name="PopupOpacitySlider" Width="160" Minimum="40" Maximum="100"
                                            TickFrequency="5" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Gün kutusunun opaklığı"
                                            ValueChanged="OnPopupOpacityChanged" />
                                    <TextBlock x:Name="PopupOpacityText" Width="40" Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SatirBasligi}" Text="Kutunun opaklığı" />
                                    <TextBlock Style="{StaticResource SatirAciklamasi}"
                                               Text="Fareyi masaüstünde bir günün üzerinde beklettiğinizde açılan kutu. Değeri küçülttükçe kutunun zemini saydamlaşır ve altındaki duvar kağıdı görünür; yazılar her değerde tam opak kalır." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================================== BOYUT VE KONUM -->
                <ScrollViewer x:Name="ScreensPage" Style="{StaticResource Sayfa}">
                    <StackPanel Style="{StaticResource SayfaIcerigi}">
                        <TextBlock Style="{StaticResource IlkGrupBasligi}" Text="Görüneceği yer" />
                        <Border Style="{StaticResource Kart}">
                            <StackPanel Margin="16,14,16,16">
                                <TextBlock Style="{StaticResource SatirBasligi}" Text="Takvim hangi ekranlarda görünsün?" />
                                <StackPanel Margin="0,12,0,0">
                                    <RadioButton x:Name="AllScreensRadio" GroupName="Hedef" Content="Tüm ekranlarda"
                                                 Checked="OnDisplayTargetChanged" />
                                    <RadioButton x:Name="PrimaryOnlyRadio" GroupName="Hedef" Content="Yalnız ana ekranda"
                                                 Margin="0,10,0,0" Checked="OnDisplayTargetChanged" />
                                    <RadioButton x:Name="SelectedScreensRadio" GroupName="Hedef" Content="Seçtiğim ekranlarda"
                                                 Margin="0,10,0,0" Checked="OnDisplayTargetChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource GrupBasligi}" Text="Bağlı ekranlar" />
                        <ItemsControl x:Name="MonitorList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Kart}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel Style="{StaticResource Satir}">
                                                <!-- Ekran okuyucu adları ekranın adını da söyler; birden çok ekranda karışmasın. -->
                                                <Button DockPanel.Dock="Right" Content="Takvimi taşı" Margin="16,0,0,0"
                                                        VerticalAlignment="Center" Click="OnMoveCalendar" Tag="{Binding}"
                                                        AutomationProperties.Name="{Binding Title, StringFormat='{}{0}: takvimi taşı'}" />
                                                <Path DockPanel.Dock="Left" Style="{StaticResource Simge}"
                                                      Data="{StaticResource SimgeEkran}" Width="20" Height="20"
                                                      Stretch="Uniform" Margin="0,0,16,0" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource SatirBasligi}" Text="{Binding Title}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource SatirAciklamasi}" Text="{Binding Detail}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <Separator />
                                            <DockPanel Style="{StaticResource Satir}">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                            Margin="16,0,0,0" VerticalAlignment="Center">
                                                    <Slider Width="180" Minimum="80" Maximum="150"
                                                            TickFrequency="5" IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="{Binding Title, StringFormat='{}{0}: boyut'}"
                                                            Value="{Binding ScalePercent, Mode=TwoWay}" />
                                                    <TextBlock Text="{Binding ScaleText}" Width="40" Margin="12,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource SatirBasligi}" Text="Boyut" />
                                                    <TextBlock Style="{StaticResource SatirAciklamasi}"
                                                               Text="Takvimin bu ekrandaki büyüklüğü." />
                                                </StackPanel>
                                            </DockPanel>
                                            <Separator />
                                            <DockPanel Style="{StaticResource Satir}">
                                                <CheckBox DockPanel.Dock="Right" Margin="24,0,0,0"
                                                          AutomationProperties.Name="{Binding Title, StringFormat='{}{0}: bu ekranda göster'}"
                                                          IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource SatirBasligi}" Text="Bu ekranda göster" />
                                                    <TextBlock Style="{StaticResource SatirAciklamasi}"
                                                               Text="“Seçtiğim ekranlarda” seçiliyken geçerlidir." />
                                                </StackPanel>
                                            </DockPanel>
                                            <Separator />
                                            <DockPanel Style="{StaticResource Satir}">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                            Margin="16,0,0,0" VerticalAlignment="Center">
                                                    <Button Content="Bu ekrana fotoğraf…" Click="OnPickMonitorPhoto"
                                                            Tag="{Binding}"
                                                            AutomationProperties.Name="{Binding Title, StringFormat='{}{0}: bu ekrana fotoğraf seç'}" />
                                                    <Button Content="Kaldır" Margin="8,0,0,0" Click="OnRemoveMonitorPhoto"
                                                            Tag="{Binding}" IsEnabled="{Binding HasPhoto}"
                                                            AutomationProperties.Name="{Binding Title, StringFormat='{}{0}: ekran fotoğrafını kaldır'}" />
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource SatirBasligi}" Text="Bu ekranın fotoğrafı" />
                                                    <TextBlock Style="{StaticResource SatirAciklamasi}"
                                                               Text="Boş bırakılırsa genel zemin kullanılır." />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource GrupBasligi}" Text="Varsayılan" />
                        <Border Style="{StaticResource Kart}">
                            <DockPanel Style="{StaticResource Satir}">
                                <Button DockPanel.Dock="Right" Content="Varsayılana dön" Margin="16,0,0,0"
                                        VerticalAlignment="Center" Click="OnResetPlacement" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SatirBasligi}" Text="Varsayılan boyut ve konum" />
                                    <TextBlock Style="{StaticResource SatirAciklamasi}"
                                               Text="Takvim her ekranda sağ alt köşeye döner: sağında bir masaüstü simgesi sığacak kadar, görev çubuğunun biraz üstünde durur; boyutu %100 olur. Hangi ekranlarda görüneceği ve ekranlara seçtiğiniz fotoğraflar değişmez." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- =============================================== GOOGLE -->
                <ScrollViewer x:Name="GooglePage" Style="{StaticResource Sayfa}">
                    <StackPanel Style="{StaticResource SayfaIcerigi}">
                        <TextBlock Style="{StaticResource IlkGrupBasligi}" Text="Google Takvim ve Görevler" />
                        <TextBlock Style="{StaticResource GrupAciklamasi}"
                                   Text="Kalender hesabınıza yalnızca okuma izniyle bağlanır; etkinlik ya da görev eklemez, silmez. Bağlantı doğrudan sizinle Google arasındadır, arada başka bir sunucu yoktur." />
                        <Border Style="{StaticResource Kart}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Satir}">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                Margin="16,0,0,0" VerticalAlignment="Center">
                                        <Button x:Name="ConnectButton" Content="Google'a bağlan" MinWidth="132"
                                                Click="OnConnectGoogle" />
                                        <Button x:Name="DisconnectButton" Content="Bağlantıyı kes" Margin="8,0,0,0"
                                                Click="OnDisconnectGoogle" />
                                    </StackPanel>
                                    <!-- Bağlanırken dönen çember: tarayıcıda onay beklenirken ve ilk veri
                                         alınırken görünür. Açı koddan döndürülür (SetConnecting). -->
                                    <Grid x:Name="ConnectSpinner" DockPanel.Dock="Left" Width="18" Height="18"
                                          Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed"
                                          AutomationProperties.Name="Bağlanılıyor">
                                        <Ellipse Stroke="{DynamicResource KenarGucluFirca}" StrokeThickness="2" />
                                        <Path Stroke="{DynamicResource VurguFirca}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 9,1 A 8,8 0 0 1 17,9" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="ConnectSpinnerAngle" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}" Text="Google hesabı" />
                                        <TextBlock x:Name="GoogleStatusText" Style="{StaticResource SatirAciklamasi}" />
                                    </StackPanel>
                                </DockPanel>
                                <Separator />
                                <DockPanel Style="{StaticResource Satir}" MinHeight="0">
                                    <Path DockPanel.Dock="Left" Style="{StaticResource Simge}" Data="{StaticResource SimgeBilgi}"
                                          Stroke="{DynamicResource SolukYaziFirca}" Margin="0,1,10,0" VerticalAlignment="Top" />
                                    <TextBlock Style="{StaticResource SatirAciklamasi}" Margin="0"
                                               Text="Bağlanmak birkaç saniye sürebilir: önce tarayıcıda onay beklenir, sonra takvimler ve görevler ilk kez alınır. Bir sorunla karşılaşırsanız Bağlantıyı kes'e basın, ardından Google'a bağlan ile yeniden bağlanıp bir süre bekleyin." />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource GrupBasligi}" Text="İstemci bilgileri" />
                        <TextBlock Style="{StaticResource GrupAciklamasi}"
                                   Text="Bu iki değer uygulamanın içinde gömülü değildir; sizin projenize aittir ve bilgisayarınızda şifreli saklanır." />
                        <Border Style="{StaticResource Kart}">
                            <StackPanel>
                                <Expander AutomationProperties.Name="Client ID nasıl alınır?">
                                    <Expander.Header>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SatirBasligi}" Text="Client ID nasıl alınır?" />
                                            <TextBlock Style="{StaticResource SatirAciklamasi}"
                                                       Text="Google Cloud'da bir kerelik yapılacak ayar." />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Style="{StaticResource AdimNo}" Text="1." />
                                            <TextBlock Style="{StaticResource Adim}"><Hyperlink
                                                NavigateUri="https://console.cloud.google.com"
                                                RequestNavigate="OnLinkClicked">console.cloud.google.com</Hyperlink><Run
                                                Text=" adresine kendi Google hesabınızla girin." /></TextBlock>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Style="{StaticResource AdimNo}" Text="2." />
                                            <TextBlock Style="{StaticResource Adim}"
                                                       Text="Üstteki proje seçiciden yeni bir proje oluşturun (adı önemli değil, örn. Kalender)." />
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Style="{StaticResource AdimNo}" Text="3." />
                                            <TextBlock Style="{StaticResource Adim}"
                                                       Text="Sol menüden API'ler ve Hizmetler &gt; Kitaplık'a girin; Google Calendar API ve Google Tasks API'yi bulup ikisini de Etkinleştir'e basın." />
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Style="{StaticResource AdimNo}" Text="4." />
                                            <TextBlock Style="{StaticResource Adim}"
                                                       Text="API'ler ve Hizmetler &gt; OAuth izin ekranı'na girin (Google Auth Platform sayfasına yönlendirir). Get started &gt; uygulama adı ve e-postanız &gt; Audience: External &gt; iletişim e-postanız &gt; ilkeyi kabul edip Create." />
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Style="{StaticResource AdimNo}" Text="5." />
                                            <TextBlock Style="{StaticResource Adim}"
                                                       Text="Sol menüden Branding: Application home page kutusuna https://github.com/SCgrS/Kalender, Application privacy policy link kutusuna https://github.com/SCgrS/Kalender#verileriniz-nerede-duruyor yazın. Authorized domains &gt; + Add domain: github.com &gt; Save. Logo eklemeyin; logo Google'ın ayrıca incelemesini gerektirir." />
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Style="{StaticResource AdimNo}" Text="6." />
                                            <TextBlock Style="{StaticResource Adim}"
                                                       Text="Sol menüden Audience &gt; Publish app &gt; Confirm. Yayınlamazsanız uygulama Testing durumunda kalır: kendinizi Test users bölümüne eklemeniz gerekir ve Google bağlantıyı 7 günde bir düşürür." />
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Style="{StaticResource AdimNo}" Text="7." />
                                            <TextBlock Style="{StaticResource Adim}"
                                                       Text="Sol menüden Clients &gt; + Create client. Application type: Desktop app. Ad: Kalender &gt; Create." />
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Style="{StaticResource AdimNo}" Text="8." />
                                            <TextBlock Style="{StaticResource Adim}" Margin="0"
                                                       Text="Çıkan pencerede Client ID ve Client secret yazar. İkisini de aşağıya yapıştırın." />
                                        </DockPanel>
                                    </StackPanel>
                                </Expander>
                                <Separator />
                                <StackPanel Style="{StaticResource DikeySatir}">
                                    <TextBlock Style="{StaticResource SatirBasligi}" Text="İstemci kimliği (Client ID)" />
                                    <TextBox x:Name="ClientIdBox" Margin="0,8,0,0" FontFamily="Consolas"
                                             AutomationProperties.Name="İstemci kimliği (Client ID)"
                                             LostFocus="OnGoogleCredentialsChanged" />
                                </StackPanel>
                                <Separator />
                                <StackPanel Style="{StaticResource DikeySatir}">
                                    <TextBlock Style="{StaticResource SatirBasligi}" Text="İstemci gizli anahtarı (Client secret)" />
                                    <!-- Ekran paylaşımında görünmesin diye noktalarla gizli. -->
                                    <PasswordBox x:Name="ClientSecretBox" Margin="0,8,0,0" FontFamily="Consolas"
                                                 AutomationProperties.Name="İstemci gizli anahtarı (Client secret)"
                                                 LostFocus="OnGoogleCredentialsChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Bağlıyken görünür. -->
                        <StackPanel x:Name="GoogleDetailsPanel">
                            <TextBlock Style="{StaticResource GrupBasligi}" Text="Yenileme" />
                            <Border Style="{StaticResource Kart}">
                                <DockPanel Style="{StaticResource Satir}">
                                    <ComboBox x:Name="PollIntervalCombo" DockPanel.Dock="Right" Width="150"
                                              Margin="16,0,0,0" VerticalAlignment="Center"
                                              AutomationProperties.Name="Ne sıklıkla yenilensin?"
                                              SelectionChanged="OnPollIntervalChanged" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}" Text="Ne sıklıkla yenilensin?" />
                                        <TextBlock Style="{StaticResource SatirAciklamasi}"
                                                   Text="Etkinlik ve görevlerin Google'dan ne sıklıkla yeniden alınacağı." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GrupBasligi}" Text="Gösterilecek takvimler" />
                            <Border Style="{StaticResource Kart}">
                                <!-- Satırlar koddan kurulur (BuildSourceList). -->
                                <StackPanel x:Name="CalendarListPanel" />
                            </Border>

                            <TextBlock Style="{StaticResource GrupBasligi}" Text="Gösterilecek görev listeleri" />
                            <Border Style="{StaticResource Kart}">
                                <StackPanel>
                                    <StackPanel x:Name="TaskListPanel" />
                                    <Separator />
                                    <DockPanel Style="{StaticResource Satir}">
                                        <ui:ColorPickerButton x:Name="TaskColorButton" DockPanel.Dock="Right"
                                                              Margin="16,0,0,0" VerticalAlignment="Center"
                                                              Title="Görev noktacığı rengi" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SatirBasligi}" Text="Görev noktacığı rengi" />
                                            <TextBlock Style="{StaticResource SatirAciklamasi}"
                                                       Text="Google, görev listeleri için renk vermiyor; bütün görevler tek renkle gösterilir." />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================================================ GENEL -->
                <ScrollViewer x:Name="GeneralPage" Style="{StaticResource Sayfa}">
                    <StackPanel Style="{StaticResource SayfaIcerigi}">
                        <TextBlock Style="{StaticResource IlkGrupBasligi}" Text="Başlangıç ve masaüstü" />
                        <Border Style="{StaticResource Kart}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Satir}">
                                    <CheckBox x:Name="StartupBox" DockPanel.Dock="Right" Margin="24,0,0,0"
                                              AutomationProperties.Name="Windows açılışında Kalender'i başlat"
                                              Checked="OnStartupChanged" Unchecked="OnStartupChanged" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}"
                                                   Text="Windows açılışında Kalender'i başlat" />
                                        <TextBlock x:Name="StartupNote" Style="{StaticResource SatirAciklamasi}" />
                                    </StackPanel>
                                </DockPanel>
                                <Separator />
                                <DockPanel Style="{StaticResource Satir}">
                                    <CheckBox x:Name="WallpaperSyncBox" DockPanel.Dock="Right" Margin="24,0,0,0"
                                              AutomationProperties.Name="Takvimi Windows duvar kağıdına işle"
                                              Checked="OnWallpaperSyncChanged" Unchecked="OnWallpaperSyncChanged" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}"
                                                   Text="Takvimi Windows duvar kağıdına işle" />
                                        <TextBlock Style="{StaticResource SatirAciklamasi}"
                                                   Text="Takvimin masaüstünde görünmesini bu sağlar: zemin ve takvim tek bir görüntü olarak duvar kağıdına yazılır. Kapatırsanız Windows duvar kağıdınıza hiç dokunulmaz, ama takvim de masaüstünde görünmez." />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource GrupBasligi}" Text="Sorun giderme" />
                        <Border Style="{StaticResource Kart}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Satir}">
                                    <ComboBox x:Name="LogLevelCombo" DockPanel.Dock="Right" Width="160"
                                              Margin="16,0,0,0" VerticalAlignment="Center"
                                              AutomationProperties.Name="Günlük ayrıntısı"
                                              SelectionChanged="OnLogLevelChanged" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}" Text="Günlük ayrıntısı" />
                                        <TextBlock Style="{StaticResource SatirAciklamasi}"
                                                   Text="Normalde yalnızca hatalar yazılır. Bir sorunu araştırırken ayrıntıyı artırabilirsiniz; günlükler küçük tutulur ve eskiyenler silinir." />
                                    </StackPanel>
                                </DockPanel>
                                <Separator />
                                <DockPanel Style="{StaticResource Satir}">
                                    <Button DockPanel.Dock="Right" Content="Günlük klasörünü aç" Margin="16,0,0,0"
                                            VerticalAlignment="Center" Click="OnOpenLogFolder" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}" Text="Günlük dosyaları" />
                                        <TextBlock Style="{StaticResource SatirAciklamasi}"
                                                   Text="Günlüklerin tutulduğu klasörü açar." />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource GrupBasligi}" Text="Hakkında" />
                        <Border Style="{StaticResource Kart}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource Satir}">
                                    <Button DockPanel.Dock="Right" Content="Sürümler sayfası" Margin="16,0,0,0"
                                            VerticalAlignment="Center" Click="OnOpenReleases" />
                                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="8"
                                            Margin="0,0,14,0" VerticalAlignment="Top"
                                            Background="{DynamicResource VurguFirca}">
                                        <Path Style="{StaticResource Simge}" Data="{StaticResource SimgeTakvim}"
                                              Stroke="{DynamicResource VurguYaziFirca}" StrokeThickness="1.4" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}" Text="Kalender"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="VersionText" Style="{StaticResource SatirAciklamasi}" />
                                        <TextBlock Style="{StaticResource SatirAciklamasi}"><Run
                                            Text="Geliştirici: " /><Hyperlink NavigateUri="https://x.com/CgrShn"
                                            RequestNavigate="OnLinkClicked"
                                            AutomationProperties.Name="Geliştirici: x.com/CgrShn">x.com/CgrShn</Hyperlink></TextBlock>
                                        <TextBlock x:Name="UpdateNote" Style="{StaticResource SatirAciklamasi}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <Separator />
                                <DockPanel Style="{StaticResource Satir}">
                                    <CheckBox x:Name="UpdateCheckBox" DockPanel.Dock="Right" Margin="24,0,0,0"
                                              AutomationProperties.Name="Güncellemeleri otomatik denetle"
                                              Checked="OnUpdateCheckChanged" Unchecked="OnUpdateCheckChanged" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}" Text="Güncellemeleri otomatik denetle" />
                                    </StackPanel>
                                </DockPanel>
                                <Separator />
                                <DockPanel Style="{StaticResource Satir}">
                                    <Button x:Name="UninstallButton" DockPanel.Dock="Right" Content="Kalender'i kaldır"
                                            Margin="16,0,0,0" VerticalAlignment="Center" Click="OnUninstall" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SatirBasligi}" Text="Uygulamayı kaldır" />
                                        <TextBlock Style="{StaticResource SatirAciklamasi}"
                                                   Text="Kaldırma penceresini açar." />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ====================================================== alt çubuk -->
            <Border Grid.Row="2" Background="{DynamicResource AltBarFirca}" Padding="36,12,36,12"
                    BorderBrush="{DynamicResource KenarFirca}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Kapat" MinWidth="96" Click="OnClose" IsCancel="True" />
                    <Path DockPanel.Dock="Left" Style="{StaticResource Simge}" Data="{StaticResource SimgeBilgi}"
                          Stroke="{DynamicResource SolukYaziFirca}" Margin="0,0,10,0" />
                    <TextBlock x:Name="FooterText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                               Margin="0,0,16,0" Foreground="{DynamicResource SolukYaziFirca}"
                               Text="Değişiklikler anında masaüstüne uygulanır." />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
