<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Kalender.Ui.PlacementOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalender - takvimi yerleştir"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="Black"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="OnKeyDown"
        MouseLeftButtonDown="OnMouseDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseUp">

    <Grid>
        <!-- Ekranın birebir önizlemesi. Canvas fiziksel piksel uzayında çalışır;
             LayoutTransform onu pencerenin DPI ölçeğine indirger. -->
        <Canvas x:Name="Stage" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Canvas.LayoutTransform>
                <ScaleTransform x:Name="StageScale" />
            </Canvas.LayoutTransform>

            <Image x:Name="BackgroundImage" Canvas.Left="0" Canvas.Top="0" />

            <!-- Fotoğraf zemininde takvimin arkasındaki karartma; takvimle birlikte taşınır. -->
            <Image x:Name="BackdropImage" />

            <Border x:Name="CalendarHost" BorderThickness="2" BorderBrush="#00FFFFFF">
                <Image x:Name="CalendarImage" />
            </Border>

            <!-- Yapışma kılavuzları -->
            <Line x:Name="GuideV" Stroke="#80FFFFFF" StrokeThickness="2" Visibility="Collapsed"
                  StrokeDashArray="6 6" />
            <Line x:Name="GuideH" Stroke="#80FFFFFF" StrokeThickness="2" Visibility="Collapsed"
                  StrokeDashArray="6 6" />
        </Canvas>

        <!-- Alt çubuk -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,56"
                Background="#F21C1F24" CornerRadius="12" Padding="18,14"
                BorderThickness="1" BorderBrush="#33FFFFFF">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="HintText" Foreground="#E8EAED" FontSize="13"
                           Text="Takvimi sürükleyip bırakın. Kenarlara yaklaşınca kendiliğinden hizalanır."
                           HorizontalAlignment="Center" Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Boyut" Foreground="#B9BEC7" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider x:Name="ScaleSlider" Width="220" Minimum="80" Maximum="150"
                            TickFrequency="5" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" ValueChanged="OnScaleChanged" />
                    <TextBlock x:Name="ScaleText" Foreground="#E8EAED" Width="52"
                               VerticalAlignment="Center" Margin="10,0,22,0" />

                    <Button x:Name="SaveButton" Content="Kaydet" Padding="18,7" Click="OnSave"
                            MinWidth="96" />
                    <Button x:Name="CancelButton" Content="Vazgeç" Padding="18,7" Click="OnCancel"
                            MinWidth="96" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
