<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Kalender.Ui.ColorWheel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">

        <!-- Renk çarkı: açı ton, merkezden uzaklık doygunluk -->
        <Grid Width="200" Height="200">
            <Image x:Name="WheelImage" Stretch="Fill" />
            <Rectangle x:Name="WheelShade" Fill="Black" Opacity="0" IsHitTestVisible="False">
                <Rectangle.Clip>
                    <EllipseGeometry Center="100,100" RadiusX="100" RadiusY="100" />
                </Rectangle.Clip>
            </Rectangle>
            <Canvas x:Name="WheelSurface" Background="Transparent"
                    MouseLeftButtonDown="OnWheelMouseDown"
                    MouseMove="OnWheelMouseMove"
                    MouseLeftButtonUp="OnWheelMouseUp">
                <Ellipse x:Name="Marker" Width="16" Height="16" IsHitTestVisible="False"
                         Stroke="White" StrokeThickness="2.5">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.7" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>

        <!-- Parlaklık şeridi -->
        <Grid Width="28" Height="200" Margin="14,0,0,0">
            <Border x:Name="ValueBar" CornerRadius="6" BorderThickness="1" BorderBrush="#40000000" />
            <Canvas x:Name="ValueSurface" Background="Transparent"
                    MouseLeftButtonDown="OnValueMouseDown"
                    MouseMove="OnValueMouseMove"
                    MouseLeftButtonUp="OnValueMouseUp">
                <Border x:Name="ValueThumb" Width="34" Height="8" Canvas.Left="-3"
                        CornerRadius="4" Background="White" BorderThickness="1" BorderBrush="#60000000"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.5" />
                    </Border.Effect>
                </Border>
            </Canvas>
        </Grid>

        <!-- Seçilen renk ve altı haneli kod -->
        <StackPanel Margin="18,0,0,0" VerticalAlignment="Top" Width="130">
            <TextBlock Text="Seçilen renk" Opacity="0.75" Margin="0,0,0,6" />
            <Border x:Name="Preview" Height="46" CornerRadius="6"
                    BorderThickness="1" BorderBrush="#40000000" />
            <TextBlock Text="Renk kodu" Opacity="0.75" Margin="0,14,0,6" />
            <TextBox x:Name="HexBox" Padding="6,4" FontFamily="Consolas"
                     KeyDown="OnHexKeyDown" LostFocus="OnHexLostFocus" />
            <TextBlock Text="Örnek: #2E3238" Opacity="0.55" FontSize="11" Margin="0,4,0,0" />
        </StackPanel>

    </StackPanel>
</UserControl>
