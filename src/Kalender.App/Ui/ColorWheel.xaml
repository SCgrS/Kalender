<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Kalender.Ui.ColorWheel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">

        <!-- Renk çarkı: açı ton, merkezden uzaklık doygunluk -->
        <Grid Width="200" Height="200">
            <Image x:Name="WheelImage" Stretch="Fill" />
            <Rectangle x:Name="WheelShade" Fill="Black" Opacity="0" IsHitTestVisible="False">
                <Rectangle.Clip>
                    <EllipseGeometry Center="100,100" RadiusX="100" RadiusY="100" />
                </Rectangle.Clip>
            </Rectangle>
            <Canvas x:Name="WheelSurface" Background="Transparent"
                    MouseLeftButtonDown="OnWheelMouseDown"
                    MouseMove="OnWheelMouseMove"
                    MouseLeftButtonUp="OnWheelMouseUp">
                <Ellipse x:Name="Marker" Width="16" Height="16" IsHitTestVisible="False"
                         Stroke="White" StrokeThickness="2.5">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.7" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>

        <!-- Parlaklık şeridi -->
        <Grid Width="24" Height="200" Margin="16,0,0,0">
            <Border x:Name="ValueBar" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{DynamicResource OrnekKenarFirca}" />
            <Canvas x:Name="ValueSurface" Background="Transparent"
                    MouseLeftButtonDown="OnValueMouseDown"
                    MouseMove="OnValueMouseMove"
                    MouseLeftButtonUp="OnValueMouseUp">
                <Border x:Name="ValueThumb" Width="30" Height="10" Canvas.Left="-3"
                        CornerRadius="5" Background="White" BorderThickness="1" BorderBrush="#60000000"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.5" />
                    </Border.Effect>
                </Border>
            </Canvas>
        </Grid>

        <!-- Seçilen renk ve altı haneli kod -->
        <StackPanel Margin="20,0,0,0" VerticalAlignment="Top" Width="128">
            <TextBlock Text="Seçilen renk" FontSize="12" Margin="0,0,0,6"
                       Foreground="{DynamicResource SolukYaziFirca}" />
            <Border x:Name="Preview" Height="56" CornerRadius="6"
                    BorderThickness="1" BorderBrush="{DynamicResource OrnekKenarFirca}" />
            <TextBlock Text="Renk kodu" FontSize="12" Margin="0,16,0,6"
                       Foreground="{DynamicResource SolukYaziFirca}" />
            <!-- Hazır kes/kopyala/yapıştır menüsü temaya uymuyor; kısayollar yine çalışır. -->
            <TextBox x:Name="HexBox" FontFamily="Consolas" AutomationProperties.Name="Renk kodu"
                     ContextMenu="{x:Null}"
                     KeyDown="OnHexKeyDown" LostFocus="OnHexLostFocus" />
        </StackPanel>

    </StackPanel>
</UserControl>
